//
// IRIS (eos) profile for Forte, run through Piano.
//
// Copied into forte/conf/eos.config by 00.SETUP.sh. See
// docs/IRIS_SLURM.md for the partition facts and the Forte timing
// data this file is tuned against. The queue/time/QoS pattern is
// ported from adagio (conf/tempo-wes-iris.config, 2026-09-27).
//

executor {
    name = "slurm"
    queueSize = 500
}

//
// Tiered queue/time picker.
//
// `ladder` is a list of [queue: <str>, time: <Duration>] maps, ordered
// from shortest tier to longest. Behavior per task.attempt:
//   attempt 1                  -> ladder[0]
//   retry, prev hit walltime   -> one tier above the previous attempt
//   retry, prev was non-wall   -> same tier as the previous attempt
//
// The previous attempt's tier is read back from task.previousTrace.time
// (its requested limit, ms) matched against the ladder, so a run of
// fast non-wall failures stays on the short tier at every attempt. If
// nothing matches (e.g. -resume across a config change) fall back to
// assuming every earlier attempt was promoted (attempt - 2).
//
// "Walltime hit" = previous run took >= (prev tier's time - 5min).
// task.previousTrace.realtime is ms (checked on Nextflow 25.10, see
// docs/IRIS_SLURM.md). A missing realtime (trace never written) is
// treated as a wall hit to force escalation; a realtime of 0 is not,
// hence the explicit null test rather than Groovy's Elvis operator.
//
// The memory ramp (label memory * task.attempt) applies on every retry
// regardless of tier, so an OOM retry gets more memory where it is.
//
def safetyMs = 5 * 60 * 1000

def tierFor = { task, ladder ->
    if ( task.attempt == 1 ) return 0
    def last    = ladder.size() - 1
    def prev    = task.previousTrace
    def prevIdx = ladder.findIndexOf { it.time.toMillis() == prev?.time }
    if ( prevIdx < 0 ) prevIdx = Math.min( task.attempt - 2, last )
    def realMs  = prev?.realtime
    def hitWall = ( realMs == null ) || realMs >= ( ladder[prevIdx].time.toMillis() - safetyMs )
    return Math.min( hitWall ? prevIdx + 1 : prevIdx, last )
}

def queueFor = { task, ladder -> ladder[ tierFor(task, ladder) ].queue }
def timeFor  = { task, ladder -> ladder[ tierFor(task, ladder) ].time  }

//
// QoS picker. cpushort only allows QoS `normal` (AllowQos=normal), and a
// multi-partition request carrying `priority` is rejected outright with
// "Invalid qos specification". So any task whose queue includes cpushort
// gets an explicit --qos=normal; every other queue (cmobic_short,
// cmobic_cpu) gets --qos=priority. `normal` is spelled out rather than
// left to the association's DefaultQOS (currently unset for core001) so
// a default change on the cluster cannot break the short tier.
//
// This only works if SBATCH_QOS is unset in the driver's environment:
// sbatch lets the environment override #SBATCH lines, which is where
// Nextflow writes clusterOptions. runForte.sh unsets it on IRIS.
//
def qosFor = { task -> task.queue?.contains('cpushort') ? '--qos=normal' : '--qos=priority' }

//
// Partitions (verified 2026-10-02, see docs/IRIS_SLURM.md):
//   cpushort      2h   232 nodes  general pool, QoS normal only, max 52 cpus/node
//   cmobic_short  3h    37 nodes  group hardware, QoS priority allowed
//   cmobic_cpu    7d    19 nodes  group hardware, QoS priority allowed
//
// cpushort and cmobic_short node sets are disjoint, so a 2h request
// naming both can land on 269 nodes. A 3h request must name
// cmobic_short alone: SLURM validates walltime against the most
// restrictive partition listed.
//
// Default ladder. Across 15 Forte runs (1185 completed tasks) every
// process except FUSIONCATCHER_DETECT and two STAR_ALIGN tasks finished
// inside 2h, almost all inside 1h. The long rung is 24h: the longest
// Forte task on record is 7.4h, so 24h is a 3x margin that still lets
// SLURM backfill, where a 7d request would not.
//
def shortLongLadder = [
    [queue: 'cpushort,cmobic_short', time: 2.h  ],
    [queue: 'cmobic_cpu',            time: 24.h ],
]

//
// STAR ladder. STAR_ALIGN at 12 cpus: p50 0.57h, p90 1.31h, max 2.08h
// (34 tasks, 94% under 2h); STAR_FOR_STARFUSION max 1.48h. The two
// tasks over 2h ran at 2.05h and 2.08h. A 2h wall kill steps to the 3h
// cmobic_short tier rather than straight to the 19-node long queue.
//
def shortMediumLongLadder = [
    [queue: 'cpushort,cmobic_short', time: 2.h  ],
    [queue: 'cmobic_short',          time: 3.h  ],
    [queue: 'cmobic_cpu',            time: 24.h ],
]

//
// FusionCatcher ladder. At 12 cpus (33 completed first attempts): p50
// 2.30h, p90 3.12h, max 7.38h; 36% finished under 2h, 82% under 3h. A
// 2h attempt would be wasted on 2 of 3 samples, so attempt 1 goes
// straight to cmobic_short at 3h (priority QoS). A wall kill there
// steps to cmobic_cpu.
//
def fusionCatcherLadder = [
    [queue: 'cmobic_short', time: 3.h  ],
    [queue: 'cmobic_cpu',   time: 24.h ],
]

process {
    resourceLimits = [
        memory: 960.GB,
        cpus  : 52,     // cpushort MaxCPUsPerNode=52 (nodes have 56)
        time  : 158.h
    ]
    memory         = "8.GB"
    queue          = { queueFor(task, shortLongLadder) }
    time           = { timeFor (task, shortLongLadder) }
    clusterOptions = { qosFor(task) }
    scratch        = "/localscratch/core001/soccin"
    beforeScript   = 'catch_term () { echo "caught USR2/TERM signal"; set +e; false; on_exit ; } ; trap catch_term USR2 TERM'
    errorStrategy  = { task.attempt <= 3 ? 'retry' : 'ignore' }
    maxRetries     = 3

    //
    // Labels. `time` must be set in every label block: forte's
    // conf/base.config sets a per-label time (4h/8h/16h/20h * attempt)
    // and a withLabel directive beats the process-level default above.
    // Memory keeps the base.config ramp (x task.attempt) so an OOM
    // retry (exit 137) gets more memory while staying in its tier.
    //
    withLabel:process_single {
        cpus   = { 1                     }
        memory = { 8.GB   * task.attempt }
        time   = { timeFor(task, shortLongLadder) }
    }
    withLabel:process_low {
        cpus   = { 2      * task.attempt }
        memory = { 16.GB  * task.attempt }
        time   = { timeFor(task, shortLongLadder) }
    }
    withLabel:process_medium {
        cpus   = { 6      * task.attempt }
        memory = { 48.GB  * task.attempt }
        time   = { timeFor(task, shortLongLadder) }
    }
    withLabel:process_high {
        cpus   = { 12     * task.attempt }
        memory = { 96.GB  * task.attempt }
        time   = { timeFor(task, shortLongLadder) }
    }
    withLabel:process_long {
        time   = { timeFor(task, shortLongLadder) }
    }
    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
        time   = { timeFor(task, shortLongLadder) }
    }

    //
    // STAR (both aliases of the same module). cpus 12 -> 16: STAR ran at
    // 900-1100% of a 1200% allocation, so it is using the cores it gets
    // and the 2.05h/2.08h tail should drop to about 1.6h. Memory is the
    // process_high 96GB, set here as well so the request does not depend
    // on the module keeping its label: peak RSS is a tight 36-41GB
    // (genome index) and does not move with thread count.
    //
    withName: 'STAR_ALIGN|STAR_FOR_STARFUSION' {
        cpus   = { 16 }
        memory = { 96.GB * task.attempt }
        queue  = { queueFor(task, shortMediumLongLadder) }
        time   = { timeFor (task, shortMediumLongLadder) }
    }

    //
    // FusionCatcher. cpus 12 -> 24: at 12 cpus it ran at ~460% of 1200%;
    // the two retries that ran at 24 cpus ran at 845-865%, so the
    // parallel phases scale and 24 should pull some of the 2-3.1h band
    // under 3h. Those two retries (different samples, first attempts
    // failed with exit 1) took 2.3h and 6.6h, so this is a projection,
    // not a same-sample comparison. Memory: peak RSS p50 26GB, p95 57GB
    // at 12 cpus, max 76GB at 24 cpus, so 96GB on attempt 1 with the x
    // attempt ramp.
    //
    withName: FUSIONCATCHER_DETECT {
        cpus   = { 24 }
        memory = { 96.GB * task.attempt }
        queue  = { queueFor(task, fusionCatcherLadder) }
        time   = { timeFor (task, fusionCatcherLadder) }
    }

    withName: PICARD_COLLECTHSMETRICS {
        cpus   = { 2      * task.attempt }
        memory = { 16.GB  * task.attempt }
    }
    withName: 'AGAT_SPADDINTRONS' {
        cpus   = { 4      * task.attempt }
    }
}

params {
    reference_base = "/data1/core001/rsrc/apps/forte"
    igenomes_base  = '/data1/core001/rsrc/genomic/mskcc-igenomes/igenomes'
    targets_base   = '/data1/core001/rsrc/apps/forte'
}


env {
    SPARK_LOCAL_DIRS = './'
}

singularity {
    enabled    = true
    runOptions = "-B $TMPDIR"
    autoMounts = true
    cacheDir   = "/scratch/core001/bic/socci/opt/singularity/cachedir/"
}
